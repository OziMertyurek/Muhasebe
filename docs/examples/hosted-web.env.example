# Namecheap cPanel Hosted Web - Phase 1 Example
#
# Do not put real secrets in this file. Add values in cPanel Setup Node.js App
# Environment variables instead.

NODE_ENV=production

# Phase 1 temporary SQLite smoke-test boundary only.
# Do not use this as final production data architecture.
# DATABASE_URL=file:./prisma/dev.db

# Phase 2 target placeholder. Do not set until PostgreSQL migration is approved.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# cPanel/Passenger provides PORT at runtime. Do not hardcode it.
# PORT=

# Phase 2A temporary PostgreSQL connectivity diagnostic.
# Keep disabled unless you are actively testing from cPanel. This is not a
# permanent application health check.
POSTGRES_DIAGNOSTIC_ENABLED=false

# Generate a one-time random value with at least 32 characters and set it only
# in cPanel environment variables. Do not commit the real token.
# POSTGRES_DIAGNOSTIC_TOKEN=

# Use only for the temporary SELECT 1 test before Prisma is migrated. Remove
# this variable and POSTGRES_DIAGNOSTIC_TOKEN when the diagnostic is no longer
# needed. Do not commit the real password.
# POSTGRES_DIAGNOSTIC_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable

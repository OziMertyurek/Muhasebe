# Hosted Web - PostgreSQL Runtime Example
#
# Do not put real secrets in this file. Add values in cPanel Setup Node.js App
# Environment variables instead.

NODE_ENV=production

# Required hosted runtime database. Put the real value in the hosting control
# panel, not in git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Document/AI processing is optional in hosted web. HOSTED_SAFE lets the app
# boot and keep uploads working even without Python, MarkItDown, or an external
# AI provider.
DOCUMENT_PROCESSOR_MODE=HOSTED_SAFE
DOCUMENT_PROCESSING_TIMEOUT_MS=30000

# Optional local filesystem upload directory. Use a path writable by the cPanel
# Node.js app user. Persistent object storage is a future phase.
# DOCUMENT_UPLOAD_DIR=/home/ACCOUNT/avorayazilim-uploads

# Reserved future external provider settings. Do not commit real secrets.
# DOCUMENT_AI_PROVIDER=disabled
# DOCUMENT_AI_API_BASE_URL=
# DOCUMENT_AI_MODEL=
# DOCUMENT_AI_API_KEY=

# cPanel/Passenger provides PORT at runtime. Do not hardcode it.
# PORT=

# Temporary PostgreSQL connectivity diagnostic. Keep disabled unless you are
# actively testing a locked-down deployment with a one-time token.
POSTGRES_DIAGNOSTIC_ENABLED=false

# Generate a one-time random value with at least 32 characters and set it only
# in cPanel environment variables. Do not commit the real token.
# POSTGRES_DIAGNOSTIC_TOKEN=

# Use only for the temporary SELECT 1 test. Do not commit the real password.
# POSTGRES_DIAGNOSTIC_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable

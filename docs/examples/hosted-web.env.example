# Namecheap cPanel Hosted Web - Phase 1 Example
#
# Do not put real secrets in this file. Add values in cPanel Setup Node.js App
# Environment variables instead.

NODE_ENV=production

# Phase 1 temporary SQLite smoke-test boundary only.
# Do not use this as final production data architecture.
# DATABASE_URL=file:./prisma/dev.db

# Phase 2 target placeholder. Do not set until PostgreSQL migration is approved.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# cPanel/Passenger provides PORT at runtime. Do not hardcode it.
# PORT=
